;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; NSIS installer script for vlc ;
; (http://nsis.sourceforge.net) ;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; redesign: brand layer, the BRAND values come from configure --with-brand (vlc / public)
!define PRODUCT_NAME "@BRAND_PRODUCT_NAME@"
!define VERSION @VERSION@
!define PRODUCT_VERSION @VERSION@
!define PRODUCT_GROUP "@BRAND_COMPANY@"
!define PRODUCT_PUBLISHER "@BRAND_COMPANY@"
!define PRODUCT_WEB_SITE "@BRAND_WEBSITE@"
!define PRODUCT_DIR_REGKEY "@BRAND_REGKEY@"
!define PRODUCT_UNINST_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\${PRODUCT_NAME}"
!define PRODUCT_UNINST_ROOT_KEY "HKLM"
!define PRODUCT_ID "@BRAND_PRODUCT_ID@"
!define PRODUCT_EXE "@BRAND_EXE@"
!define PRODUCT_INSTALL_DIR "@BRAND_INSTALL_DIR@"
; prefix of the ProgIDs, shell verbs, autoplay handlers and default programs entry the installer
; registers ("VLC" or "Cone"): Cone's are its own, so installing or removing it never touches an
; installed VLC's (redesign/CONE_RELEASE_NOTES.md)
!define PRODUCT_PROGID "@BRAND_PROGID@"
!if "${PRODUCT_PROGID}" == "VLC"
  !define PRODUCT_SHORT_NAME "VLC"
  !define PRODUCT_DESCRIPTION "VLC - The video swiss knife"
  ; the user settings folder in %APPDATA% (src/win32/dirs.c)
  !define PRODUCT_APPDATA_DIR "vlc"
  !define PRODUCT_DOC_URL "${PRODUCT_WEB_SITE}/doc/"
  !define PRODUCT_SKINS_URL "${PRODUCT_WEB_SITE}/vlc/skins.php"
  !define PRODUCT_WEBSITE_LINK "${PRODUCT_GROUP} Website"
  !define PRODUCT_BRANDING_TEXT "${PRODUCT_GROUP} ${PRODUCT_NAME}"
!else
  !define PRODUCT_SHORT_NAME "${PRODUCT_NAME}"
  !define PRODUCT_DESCRIPTION "${PRODUCT_NAME}, a media player based on VLC media player"
  !define PRODUCT_APPDATA_DIR "${PRODUCT_NAME}"
  ; the project page holds the documentation; VLC's skins work in the skinned interface too
  !define PRODUCT_DOC_URL "${PRODUCT_WEB_SITE}#readme"
  !define PRODUCT_SKINS_URL "https://www.videolan.org/vlc/skins.php"
  !define PRODUCT_WEBSITE_LINK "${PRODUCT_NAME} Website"
  !define PRODUCT_BRANDING_TEXT "${PRODUCT_NAME}"
!endif

!define MUI_LANGDLL_REGISTRY_ROOT "HKLM"
!define MUI_LANGDLL_REGISTRY_KEY "${PRODUCT_DIR_REGKEY}"
!define MUI_LANGDLL_REGISTRY_VALUENAME "Language"

!define MEMENTO_REGISTRY_ROOT ${PRODUCT_UNINST_ROOT_KEY}
!define MEMENTO_REGISTRY_KEY "${PRODUCT_UNINST_KEY}"

@HAVE_WIN64_TRUE@ !define VLC_64BIT_INSTALLER

ManifestDPIAware true
Unicode true

; !define INSTALL_ACTIVEX

Var ReinstallType
Var ReinstallUninstallBtn
Var PerformUpdate
Var PreviousVersion
Var PreviousVersionState
Var PreviousInstallDir
Var UninstallLog

Var 32bitUninstaller
Var 32bitPath

;;;;;;;;;;;;;;;;;;;;;;;;;
; General configuration ;
;;;;;;;;;;;;;;;;;;;;;;;;;

Name "${PRODUCT_NAME}"
@HAVE_WIN64_FALSE@                   OutFile ..\@BRAND_INTERNAL_NAME@-${VERSION}-win32.exe
@HAVE_WIN64_TRUE@ @HAVE_ARM64_FALSE@ OutFile ..\@BRAND_INTERNAL_NAME@-${VERSION}-win64.exe
@HAVE_WIN64_TRUE@ @HAVE_ARM64_TRUE@  OutFile ..\@BRAND_INTERNAL_NAME@-${VERSION}-winarm64.exe
InstallDir "$@PROGRAMFILES@\${PRODUCT_INSTALL_DIR}"
!ifdef NSIS_LZMA_COMPRESS_WHOLE
SetCompressor lzma
!else
SetCompressor /SOLID lzma
!endif

SetOverwrite ifdiff
CRCCheck on
BrandingText "${PRODUCT_BRANDING_TEXT}"

InstType "$(Name_InstTypeRecommended)"
InstType "$(Name_InstTypeMinimum)"
InstType "$(Name_InstTypeFull)"

RequestExecutionLevel admin
!addincludedir NSIS
!addplugindir NSIS
!include nsProcess.nsh
!include WinVer.nsh
!include FileFunc.nsh
!include MUI2.nsh
!include Memento.nsh

!insertmacro GetParameters
!insertmacro GetOptions

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; NSIS Modern User Interface configuration ;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; MUI Settings
  !define MUI_ABORTWARNING
  !define MUI_ICON "@BRAND_ICON_FILE@"
  !define MUI_UNICON "@BRAND_ICON_FILE@"
  !define MUI_COMPONENTSPAGE_SMALLDESC

  ; Banner (welcome and finish page) for installer
@BRAND_NSIS_BITMAP_TRUE@  !define MUI_WELCOMEFINISHPAGE_BITMAP "NSIS/vlc_branding.bmp"
  ; Banner for uninstaller
@BRAND_NSIS_BITMAP_TRUE@  !define MUI_UNWELCOMEFINISHPAGE_BITMAP "NSIS/vlc_branding.bmp"
!if "${PRODUCT_PROGID}" != "VLC"
  ; redesign: brand layer, Cone's side image (welcome and finish pages of the installer and
  ; uninstaller) and page header image (extras/package/win32/brand/public, installer-art.js)
  !define MUI_WELCOMEFINISHPAGE_BITMAP "NSIS/nsis-welcome.bmp"
  !define MUI_UNWELCOMEFINISHPAGE_BITMAP "NSIS/nsis-welcome.bmp"
  !define MUI_HEADERIMAGE
  !define MUI_HEADERIMAGE_RIGHT
  !define MUI_HEADERIMAGE_BITMAP "NSIS/nsis-header.bmp"
  !define MUI_HEADERIMAGE_UNBITMAP "NSIS/nsis-header.bmp"
!endif

; Installer pages
  ; Welcome page
    !define MUI_PAGE_CUSTOMFUNCTION_PRE PageFastUpdatePre
    !define MUI_WELCOMEPAGE_TITLE_3LINES
    !insertmacro MUI_PAGE_WELCOME
  ; Optional update page
    Page custom PageReinstall PageLeaveReinstall
  ; License page
    !define MUI_LICENSEPAGE_BUTTON $(^NextBtn)
    !define MUI_LICENSEPAGE_TEXT_BOTTOM "$(License_NextText)"
    !define MUI_PAGE_CUSTOMFUNCTION_PRE PageSkipPre
    !insertmacro MUI_PAGE_LICENSE "COPYING.txt"
  ; Components page
    !define MUI_PAGE_CUSTOMFUNCTION_PRE PageComponentsPre
    !insertmacro MUI_PAGE_COMPONENTS
  ; Directory page
    !define MUI_PAGE_CUSTOMFUNCTION_PRE PageDirectoryPre
    !insertmacro MUI_PAGE_DIRECTORY
  ; Instfiles page
    !insertmacro MUI_PAGE_INSTFILES
  ; Finish page
    !define MUI_PAGE_CUSTOMFUNCTION_PRE PageFastUpdatePre
    !define MUI_FINISHPAGE_RUN
    !define MUI_FINISHPAGE_RUN_FUNCTION AppExecAs
    !define MUI_FINISHPAGE_LINK "$(Link_VisitWebsite)"
    !define MUI_FINISHPAGE_LINK_LOCATION "@BRAND_FINISH_LINK@"
    !define MUI_FINISHPAGE_NOREBOOTSUPPORT
    !insertmacro MUI_PAGE_FINISH

; Uninstaller pages
    !insertmacro MUI_UNPAGE_CONFIRM
    !insertmacro MUI_UNPAGE_COMPONENTS
    !insertmacro MUI_UNPAGE_INSTFILES
    !insertmacro MUI_UNPAGE_FINISH

  !addincludedir "languages"
  !define VLC_LANGFILE_FALLBACK "EnglishExtra.nsh"

