   "open": [
    {"wiggle": [640, 400], "after": 600},
    {"expect": {"uia": "Player controls", "visible": true}, "check": "control bar shown"},
    {"expect": {"uia": "Player topbar", "visible": true}, "check": "top bar shown"},
    {"shot": "open"}
   ],
   "action": [
    {"uia": "Play/Pause", "role": "Button", "after": 2500},
    {"wiggle": [208, 692], "after": 400},
    {"shot": "playing"},
    {"uia": "Play/Pause", "role": "Button", "after": 600}
   ],
   "close": []
  },
  {
   "id": "sidebar",
